{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "gtum",
  "version": "0.1.0",
  "identifier": "com.gagakor.gtum",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "gtum",
        "width": 1320,
        "height": 824,
        "resizable": true,
        "decorations": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/GagaKor/gtum/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJGNEYwMkQ5MzMwNDNEOEMKUldTTVBRUXoyUUpQTHlsSEVVYkZIQ0licHp1WS9oaWNpVFh3d2RycGdjZVRaN2g1VUlERjE1RG0K"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
